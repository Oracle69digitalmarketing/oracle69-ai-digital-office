generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id           String        @id @default(uuid())
  name         String
  industry     String?
  country      String?
  timezone     String?
  subscription String        @default("starter")
  status       String        @default("active")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  users        User[]
  departments  Department[]
  projects     Project[]
  clients      Client[]
  settings     Setting[]
  agents       Agent[]
  agentRegistryEntries AgentRegistryEntry[]
  workflowStepRecords  WorkflowStepRecord[]
  longTermMemoryRecords LongTermMemoryRecord[]
  auditLogs            AuditLog[]
  conversations        Conversation[]
  integrationCredentials IntegrationCredential[]
  crmOrganizations     CrmOrganization[]
  crmContacts          CrmContact[]
  crmLeads             CrmLead[]
  crmOpportunities     CrmOpportunity[]
  crmPipelines         CrmPipeline[]
  crmActivities        CrmActivity[]
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  password       String
  name           String?
  role           String         @default("employee")
  status         String         @default("active")
  avatar         String?
  lastLogin      DateTime?
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  conversations  Conversation[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  settings       Setting[]
  ownedCrmContacts    CrmContact[]
  ownedCrmLeads       CrmLead[]
  ownedCrmOpportunities CrmOpportunity[]
  assignedCrmActivities CrmActivity[]
}

model CrmOrganization {
  id             String       @id @default(uuid())
  name           String
  industry       String?
  employees      Int?
  revenue        Float?
  website        String?
  address        String?
  city           String?
  country        String?
  status         String       @default("active")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  contacts       CrmContact[]
  opportunities  CrmOpportunity[]
  leads          CrmLead[]
  notes          CrmNote[]
}

model CrmContact {
  id             String       @id @default(uuid())
  firstName      String
  lastName       String
  email          String?
  phone          String?
  jobTitle       String?
  source         String?
  tags           String[]
  status         String       @default("active")
  crmOrganizationId String?
  crmOrganization   CrmOrganization? @relation(fields: [crmOrganizationId], references: [id])
  ownerId        String?
  owner          User?        @relation(fields: [ownerId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  activities     CrmActivity[]
  notes          CrmNote[]
  opportunities  CrmOpportunity[] @relation("OpportunityContacts")
}

model CrmLead {
  id             String       @id @default(uuid())
  title          String?
  source         String?
  status         String       @default("new")
  score          Float?       @default(0)
  crmOrganizationId String?
  crmOrganization   CrmOrganization? @relation(fields: [crmOrganizationId], references: [id])
  ownerId        String?
  owner          User?        @relation(fields: [ownerId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  notes          CrmNote[]
  activities     CrmActivity[]
}

model CrmOpportunity {
  id             String       @id @default(uuid())
  name           String
  value          Float
  stage          String
  probability    Float?
  expectedCloseDate DateTime?
  crmOrganizationId String?
  crmOrganization   CrmOrganization? @relation(fields: [crmOrganizationId], references: [id])
  ownerId        String?
  owner          User?        @relation(fields: [ownerId], references: [id])
  pipelineId     String
  pipeline       CrmPipeline  @relation(fields: [pipelineId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  contacts       CrmContact[] @relation("OpportunityContacts")
  notes          CrmNote[]
  activities     CrmActivity[]
}

model CrmPipeline {
  id             String       @id @default(uuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  stages         CrmPipelineStage[]
  opportunities  CrmOpportunity[]
}

model CrmPipelineStage {
  id             String       @id @default(uuid())
  name           String
  order          Int
  probability    Float?
  pipelineId     String
  pipeline       CrmPipeline  @relation(fields: [pipelineId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model CrmActivity {
  id             String       @id @default(uuid())
  type           String       // call, meeting, email, task
  subject        String
  description    String?
  status         String       @default("planned")
  dueDate        DateTime?
  crmContactId   String?
  crmContact     CrmContact?  @relation(fields: [crmContactId], references: [id])
  crmLeadId      String?
  crmLead        CrmLead?     @relation(fields: [crmLeadId], references: [id])
  crmOpportunityId String?
  crmOpportunity   CrmOpportunity? @relation(fields: [crmOpportunityId], references: [id])
  assignedToId   String?
  assignedTo     User?        @relation(fields: [assignedToId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  notes          CrmNote[]
}

model CrmNote {
  id               String       @id @default(uuid())
  content          String
  crmOrganizationId String?
  crmOrganization   CrmOrganization? @relation(fields: [crmOrganizationId], references: [id])
  crmContactId     String?
  crmContact       CrmContact?  @relation(fields: [crmContactId], references: [id])
  crmLeadId        String?
  crmLead          CrmLead?     @relation(fields: [crmLeadId], references: [id])
  crmOpportunityId String?
  crmOpportunity   CrmOpportunity? @relation(fields: [crmOpportunityId], references: [id])
  crmActivityId    String?
  crmActivity      CrmActivity? @relation(fields: [crmActivityId], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Department {
  id             String       @id @default(uuid())
  name           String
  description    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  agents         Agent[]
}

model Agent {
  id            String      @id @default(uuid())
  name          String
  role          String
  capabilities  String[]
  assignedModel String      @default("gemini-2.0-flash")
  status        String      @default("idle")
  version       String      @default("1.0.0")
  health        String      @default("healthy")
  departmentId  String
  department    Department  @relation(fields: [departmentId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  tasks         Task[]
  auditLogs     AuditLog[]
}

model Project {
  id             String         @id @default(uuid())
  title          String
  description    String?
  status         String         @default("planning")
  priority       String         @default("medium")
  budget         Float?
  startDate      DateTime?
  endDate        DateTime?
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  clientId       String?
  client         Client?        @relation(fields: [clientId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tasks          Task[]
  workflows      Workflow[]
  conversations  Conversation[]
  memory         Memory[]
  documents      Document[]
}

model Task {
  id            String    @id @default(uuid())
  title         String
  description   String?
  priority      String    @default("medium")
  status        String    @default("pending")
  dependencies  String[]
  deadline      DateTime?
  estimatedCost Float?
  executionTime Int?
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id])
  assignedAgentId String?
  assignedAgent   Agent?    @relation(fields: [assignedAgentId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Workflow {
  id            String    @id @default(uuid())
  name          String
  executionType String    @default("sequential")
  currentStage  String?
  status        String    @default("not_started")
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id])
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
}

model Client {
  id             String       @id @default(uuid())
  name           String
  industry       String?
  contactPerson  String?
  email          String?
  phone          String?
  country        String?
  preferences    Json?
  status         String       @default("active")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  projects       Project[]
}

model Conversation {
  id             String       @id @default(uuid())
  status         String       @default("open")
  summary        String?
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  closedAt       DateTime?
  messages       Message[]

  @@index([organizationId, updatedAt])
}

model Message {
  id             String       @id @default(uuid())
  sender         String
  receiver       String?
  content        String
  modelUsed      String?
  tokenCount     Int?
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Memory {
  id                  String   @id @default(uuid())
  category            String
  summary             String
  embeddingReference  String?
  confidence          Float?
  accessLevel         String   @default("internal")
  projectId           String?
  project             Project? @relation(fields: [projectId], references: [id])
  department          String?
  client              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Document {
  id         String   @id @default(uuid())
  title      String
  category   String
  ownerId    String
  version    String   @default("1.0.0")
  storageUrl String
  status     String   @default("active")
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Notification {
  id        String    @id @default(uuid())
  message   String
  priority  String    @default("medium")
  status    String    @default("unread")
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  readAt    DateTime?
}

model AuditLog {
  id             String       @id @default(uuid())
  action         String
  resource       String
  status         String
  ipAddress      String?
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  agentId        String?
  agent          Agent?       @relation(fields: [agentId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model Setting {
  id             String        @id @default(uuid())
  key            String
  value          Json
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  updatedAt      DateTime      @updatedAt

  @@unique([key, userId, organizationId])
}

model AgentRegistryEntry {
  id               String       @id @default(uuid())
  agentId          String
  role             String
  healthStatus     String
  lastHeartbeatAt  DateTime
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model WorkflowStepRecord {
  id               String       @id @default(uuid())
  stepId           String
  workflowId       String
  taskId           String
  agentId          String
  status           String
  startTime        DateTime
  endTime          DateTime?
  result           Json?
  error            String?
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model LongTermMemoryRecord {
  id               String       @id @default(uuid())
  type             String
  sessionId        String
  content          String
  metadata         Json?
  timestamp        DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  embedding      Unsupported("vector(768)")?
  createdAt      DateTime    @default(now())
  }

model IntegrationCredential {
  id             String       @id @default(uuid())
  provider       String       // e.g., 'google', 'slack', 'hubspot'
  type           String       // e.g., 'oauth2', 'apikey'
  accessToken    String?      @db.Text
  refreshToken   String?      @db.Text
  expiresAt      DateTime?
  apiKey         String?      @db.Text
  metadata       Json?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([provider, organizationId])
}



